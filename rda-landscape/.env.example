# Copy to .env.local for local dev. In production these live ONLY in
# Netlify Environment Variables — never commit real values.

# console.anthropic.com — powers the AI instant-quote photo analysis.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-4-8 if unset.
ANTHROPIC_MODEL=

# web3forms.com — free lead-email delivery, no backend required.
WEB3FORMS_ACCESS_KEY=

# analytics.google.com — GA4 measurement ID (e.g. G-XXXXXXXXXX). Exposed to
# the browser by design (NEXT_PUBLIC_), same as any GA snippet.
NEXT_PUBLIC_GA_ID=
